SHOP_LOGO_DARK=/images/logo-dark.png
SHOP_LOGO_LIGHT=/images/logo-light.png
SHOP_MAP_ICON=/images/map-icon.png

# URLs
URL=https://syoraparis.com
API_URL=https://api.syoraparis.com
