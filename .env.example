# Language
DEFAULT_LANGUAGE=fr

# Google Services
GOOGLE_MAP_KEY=your-google-map-key
GOOGLE_CLIENT_ID=your-google-client-id

# Payment Providers
STRIPE_PUBLIC_KEY=your-stripe-public-key
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYZEN_PUBLIC_KEY=your-payzen-public-key
ALMA_URL=your-alma-url
ALMA_CLIENT_ID=your-alma-client-id
ALMA_TOKEN=your-alma-token

# Google Tag Manager
GTM_ID=GTM-XXXXXXX

# reCAPTCHA
RECAPTCHA_SITE_KEY=your-recaptcha-site-key

# Feature Flags
HAS_COUNTRY_OUT=disabled
LOCK_USER=admin
LOCK_PASSWORD=password
APP_LOYALTY=enabled
APP_REFERRAL=disabled
